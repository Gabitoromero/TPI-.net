@using API.Clients
@using BlazorApp.Services
@inject AuthStateContainer AuthStateContainer
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

@if (APIClientBase.IsTokenValid())
{
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">Sistema Académico</a>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    Inicio
                </NavLink>
            </div>

            @{
                var role = APIClientBase.LoginResponse?.Tipo;
            }

            @if (role?.ToLower() == "profesor")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profesor/cursos">
                         Mis Cursos
                    </NavLink>
                </div>
            }

            @if (role?.ToLower() == "alumno")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="alumno/inscripciones">
                         Mis Inscripciones
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="alumno/inscripciones/nueva">
                         Inscribirme
                    </NavLink>
                </div>
            }

            @if (role?.ToLower() == "admin")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="comisiones">
                         Comisiones
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="especialidades">
                         Especialidades
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="materias">
                         Materias
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="planes">
                         Planes
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuario/perfil">
                     Perfil
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button type="button" class="nav-link btn btn-link text-start w-100" @onclick="HandleLogout">
                     Cerrar Sesión
                </button>
            </div>
        </nav>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AuthStateContainer.OnAuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        try
        {
            await APIUsuario.LogoutAsync();
            AuthStateContainer.NotifyStateChanged();
            Navigation.NavigateTo("/login", forceLoad: true);            
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        AuthStateContainer.OnAuthStateChanged -= OnAuthStateChanged;
    }
}

