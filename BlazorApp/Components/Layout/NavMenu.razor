@using BlazorApp.Services
@using API.Clients
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

@if (AuthState.IsAuthenticated)
{
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">Sistema Académico</a>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
                </NavLink>
            </div>

            @if (AuthState.IsProfesor)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profesor/cursos">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Cursos
                    </NavLink>
                </div>
            }

            @if (AuthState.IsAlumno)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="alumno/inscripciones">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Inscripciones
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="alumno/inscripciones/nueva">
                        <span class="bi bi-plus-circle-fill" aria-hidden="true"></span> Inscribirme
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuario/perfil">
                    <span class="bi bi-person-circle" aria-hidden="true"></span> Perfil
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button type="button" class="nav-link btn btn-link text-start w-100" @onclick="HandleLogout">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesión
                </button>
            </div>
        </nav>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AuthState.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleLogout()
    {
        try
        {
            await APIUsuario.LogoutAsync();
            AuthState.Logout();
            Navigation.NavigateTo("/login", forceLoad: true);            
        }

        catch (Exception ex)
        {
            Console.WriteLine($"Error en logout: {ex.Message}");
        }
    }
    public void Dispose()
    {
        AuthState.OnAuthStateChanged -= StateHasChanged;
    }
}

