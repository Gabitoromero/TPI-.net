@using API.Clients
@using BlazorApp.Services
@inject AuthStateContainer AuthStateContainer
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

@if (APIClientBase.IsTokenValid())
{
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">Sistema Académico</a>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
                </NavLink>
            </div>

            @{
                var role = JwtHelper.GetRole(APIClientBase.LoginResponse?.Token);
            }

            @if (role?.ToLower() == "profesor")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profesor/cursos">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Cursos
                    </NavLink>
                </div>
            }

            @if (role?.ToLower() == "alumno")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="alumno/inscripciones">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Inscripciones
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="alumno/inscripciones/nueva">
                        <span class="bi bi-plus-circle-fill" aria-hidden="true"></span> Inscribirme
                    </NavLink>
                </div>
            }

            @if (role?.ToLower() == "admin")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="comisiones">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Comisiones
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="especialidades">
                        <span class="bi bi-book-nav-menu" aria-hidden="true"></span> Especialidades
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="materias">
                        <span class="bi bi-journal-text" aria-hidden="true"></span> Materias
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="planes">
                        <span class="bi bi-folder-nav-menu" aria-hidden="true"></span> Planes
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuario/perfil">
                    <span class="bi bi-person-circle" aria-hidden="true"></span> Perfil
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button type="button" class="nav-link btn btn-link text-start w-100" @onclick="HandleLogout">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesión
                </button>
            </div>
        </nav>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AuthStateContainer.OnAuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        try
        {
            await APIUsuario.LogoutAsync();
            AuthStateContainer.NotifyStateChanged();
            Navigation.NavigateTo("/login", forceLoad: true);            
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        AuthStateContainer.OnAuthStateChanged -= OnAuthStateChanged;
    }
}

