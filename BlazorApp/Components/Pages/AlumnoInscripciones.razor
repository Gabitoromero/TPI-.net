@page "/alumno/inscripciones"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Reports
@using BlazorApp.Components.Shared
@using QuestPDF.Fluent
@using QuestPDF.Infrastructure
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Mis Inscripciones</PageTitle>

<AuthorizeView RequireAlumno="true">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Mis Inscripciones</h3>
            <button class="btn btn-primary" @onclick="MostrarModalReporte">
                <i class="bi bi-file-pdf"></i> Generar Reporte Plan de Estudios
            </button>
        </div>

        @if (alumnoDeshabilitado)
        {
            <div class="alert alert-warning" role="alert">
                <strong>⚠️ Cuenta Deshabilitada:</strong> Tu cuenta no está habilitada. Por favor, contacta al administrador.
            </div>
        }
        else if (inscripciones == null)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p>Cargando tus inscripciones...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                <strong> Error:</strong> @errorMessage
            </div>
        }
        else if (!inscripciones.Any())
        {
            <div class="alert alert-info" role="alert">
                 No tienes inscripciones registradas. 
                <a href="/alumno/inscripciones/nueva" class="alert-link">Haz clic aquí para inscribirte a un curso</a>.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Materia</th>
                            <th>Comisión</th>
                            <th>Condición</th>
                            <th>Nota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inscripcion in inscripciones)
                        {
                            <tr>
                                <td>@inscripcion.Materia</td>
                                <td>@inscripcion.Comision</td>
                                <td>
                                    @if (inscripcion.Condicion == "Regular")
                                    {
                                        <span class="badge bg-success">@inscripcion.Condicion</span>
                                    }
                                    else if (inscripcion.Condicion == "Libre")
                                    {
                                        <span class="badge bg-warning text-dark">@inscripcion.Condicion</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@inscripcion.Condicion</span>
                                    }
                                </td>
                                <td>
                                    @if (inscripcion.Nota.HasValue)
                                    {
                                        @if (inscripcion.Nota >= 6)
                                        {
                                            <span class="badge bg-success">@inscripcion.Nota</span>
                                        }
                                        else if (inscripcion.Nota >= 4)
                                        {
                                            <span class="badge bg-warning text-dark">@inscripcion.Nota</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@inscripcion.Nota</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted">
                <small>Total de inscripciones: @inscripciones.Count</small>
            </p>
        }
    </div>
</AuthorizeView>

@code {
    private List<InscripcionDisplayDTO> inscripciones;
    private string errorMessage;
    private bool alumnoDeshabilitado = false;
    private bool mostrarModal = false;
    private bool generandoReporte = false;
    private string? errorReporte;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 🔐 Obtener el ID directamente del token JWT
            var alumnoId = JwtHelper.GetUserId(APIClientBase.LoginResponse?.Token);
            
            if (alumnoId == null)
            {
                errorMessage = "No se pudo obtener el ID del usuario";
                return;
            }

            // Obtener información del alumno para verificar si está habilitado
            var alumno = await APIUsuario.GetAsync(alumnoId.Value);

            if (alumno == null)
            {
                errorMessage = "Usuario no encontrado";
                return;
            }
            
            if (!alumno.Habilitado)
            {
                alumnoDeshabilitado = true;
                return;
            }

            var inscripcionesAlumno = await APIUsuario.GetAlumnoCursosAsync(alumnoId.Value);

            if (inscripcionesAlumno == null || !inscripcionesAlumno.Any())
            {
                inscripciones = new List<InscripcionDisplayDTO>();
                return;
            }

            var materiaTasks = inscripcionesAlumno.Select(i => APIMateria.GetAsync(i.Curso.Id_materia)).ToList();
            var comisionTasks = inscripcionesAlumno.Select(i => APIComision.GetAsync(i.Curso.Id_comision)).ToList();
            var materias = await Task.WhenAll(materiaTasks);
            var comisiones = await Task.WhenAll(comisionTasks);

            inscripciones = inscripcionesAlumno.Select((i, idx) => new InscripcionDisplayDTO
            {
                Materia = materias[idx].Desc_materia,
                Comision = comisiones[idx].Desc_comision,
                Condicion = i.Condicion,
                Nota = i.Nota
            }).ToList();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las inscripciones: {ex.Message}";
        }
    }

    private void MostrarModalReporte()
    {
        // ✅ SOLUCIÓN MÁS SIMPLE: Redirigir directamente sin modal
        // La página de reporte se encarga de todo
        Navigation.NavigateTo("/reporte/plan-estudios");
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        errorReporte = null;
    }

    private void GenerarReportePlan()
    {
        // Este método ya no se usa, pero lo dejamos por compatibilidad
        Navigation.NavigateTo("/reporte/plan-estudios");
    }
}
