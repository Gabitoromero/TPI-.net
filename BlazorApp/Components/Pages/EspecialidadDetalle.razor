@page "/especialidades/detalle"
@page "/especialidades/detalle/{IdEspecialidad:int}"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Shared
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(IdEspecialidad.HasValue ? "Modificar Especialidad" : "Nueva Especialidad")</PageTitle>

<AuthorizeView RequireAdmin="true">
    <div class="container mt-4">
        <div class="card">
            <div class="card-header">
                <h4>@(IdEspecialidad.HasValue ? "Modificar Especialidad" : "Nueva Especialidad")</h4>
            </div>
            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else if (errorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Error:</strong> @errorMessage
                    </div>
                }
                else
                {
                    <form @onsubmit="GuardarEspecialidad" @onsubmit:preventDefault="true">
                        <div class="mb-3">
                            <label for="descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" 
                                   id="descripcion" 
                                   class="form-control @(errorDescripcion ? "is-invalid" : "")" 
                                   @bind="especialidad.Descripcion"
                                   @bind:event="oninput"
                                   placeholder="Ingrese la descripción de la especialidad" />
                            @if (errorDescripcion)
                            {
                                <div class="invalid-feedback">La descripción es requerida</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-success" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar</span>
                                }
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</AuthorizeView>

@code {
    [Parameter]
    public int? IdEspecialidad { get; set; }

    private EspecialidadDTO especialidad = new EspecialidadDTO();
    private string? errorMessage;
    private bool errorDescripcion = false;
    private bool isLoading = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            if (IdEspecialidad.HasValue)
            {
                var especialidadExistente = await APIEspecialidad.GetAsync(IdEspecialidad.Value);
                
                if (especialidadExistente != null)
                {
                    especialidad = especialidadExistente;
                }
                else
                {
                    errorMessage = "No se encontró la especialidad";
                }
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool ValidarFormulario()
    {
        bool esValido = true;

        errorDescripcion = false;

        if (string.IsNullOrWhiteSpace(especialidad.Descripcion))
        {
            errorDescripcion = true;
            esValido = false;
        }

        return esValido;
    }

    private async Task GuardarEspecialidad()
    {
        if (!ValidarFormulario())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (IdEspecialidad.HasValue)
            {
                await APIEspecialidad.UpdateAsync(especialidad);
            }
            else
            {
                var nuevaEsp = new NewEspecialidadDTO { Descripcion = especialidad.Descripcion };
                await APIEspecialidad.AddAsync(nuevaEsp);
            }

            Navigation.NavigateTo("/especialidades");
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar la especialidad: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/especialidades");
    }
}
