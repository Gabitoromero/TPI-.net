<div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <span class="bi bi-question-circle-fill me-2"></span>
                    Confirmación
                </h5>
                <button type="button" class="btn-close" @onclick="Cancelar"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-3">
                    <div class="display-1 text-warning mb-3">
                        <span class="bi bi-question-circle"></span>
                    </div>
                    <p style="white-space: pre-line;">@Mensaje</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                <button type="button" class="btn btn-primary" @onclick="Confirmar">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Mensaje { get; set; }

    [Parameter]
    public EventCallback OnConfirmar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private void Confirmar()
    {
        OnConfirmar.InvokeAsync();
    }

    private void Cancelar()
    {
        OnCancelar.InvokeAsync();
    }
}
