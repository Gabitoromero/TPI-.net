@page "/especialidades"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Shared
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Especialidades</PageTitle>

<AuthorizeView RequireAdmin="true">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Especialidades</h3>
            <button class="btn btn-primary" @onclick="AgregarEspecialidad">
                <i class="bi bi-plus-circle"></i> Agregar
            </button>
        </div>

        @if (especialidades == null)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p>Cargando especialidades...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Error:</strong> @errorMessage
            </div>
        }
        else if (!especialidades.Any())
        {
            <div class="alert alert-info" role="alert">
                No hay especialidades registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var especialidad in especialidades)
                        {
                            <tr>
                                <td>@especialidad.Id</td>
                                <td>@especialidad.Descripcion</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => ModificarEspecialidad(especialidad.Id)">
                                        <i class="bi bi-pencil"></i> Modificar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => MostrarConfirmacionEliminar(especialidad.Id, especialidad.Descripcion)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</AuthorizeView>

@if (mostrarConfirmacion)
{
    <MensajeConfirmacionModal 
        Mensaje="@mensajeConfirmacion"
        OnConfirmar="ConfirmarEliminar"
        OnCancelar="CancelarEliminar" />
}

@code {
    private List<EspecialidadDTO>? especialidades;
    private string? errorMessage;
    private bool mostrarConfirmacion = false;
    private string mensajeConfirmacion = string.Empty;
    private int idEspecialidadAEliminar;
    private string descripcionEspecialidadAEliminar = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarEspecialidades();
    }

    private async Task CargarEspecialidades()
    {
        try
        {
            errorMessage = null;
            especialidades = await APIEspecialidad.GetAllAsync();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las especialidades: {ex.Message}";
        }
    }

    private void AgregarEspecialidad()
    {
        Navigation.NavigateTo("/especialidades/detalle");
    }

    private void ModificarEspecialidad(int id)
    {
        Navigation.NavigateTo($"/especialidades/detalle/{id}");
    }

    private void MostrarConfirmacionEliminar(int id, string descripcion)
    {
        idEspecialidadAEliminar = id;
        descripcionEspecialidadAEliminar = descripcion;
        mensajeConfirmacion = $"¿Está seguro que desea eliminar la especialidad '{descripcion}'?\n\nEsta acción no se puede deshacer.";
        mostrarConfirmacion = true;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirmacion = false;
        
        try
        {
            await APIEspecialidad.DeleteAsync(idEspecialidadAEliminar);
            await CargarEspecialidades();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la especialidad: {ex.Message}";
        }
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }
}
