@page "/"
@using API.Clients
@inject NavigationManager Navigation

<PageTitle>Inicio</PageTitle>

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">Bienvenido al Sistema Académico</h1>
        
        @if (APIClientBase.IsTokenValid())
        {
            var username = APIClientBase.LoginResponse?.Username;
            var role = JwtHelper.GetRole(APIClientBase.LoginResponse?.Token);
            
            <p class="lead mt-4">
                Hola, <strong>@username</strong>!
            </p>
            
            @if (role?.ToLower() == "alumno")
            {
                <div class="mt-4">
                    <p>Eres un <strong>Alumno</strong>. Puedes:</p>
                    <div class="d-grid gap-2 col-6 mx-auto mt-3">
                        <a href="/alumno/inscripciones" class="btn btn-primary btn-lg">
                            Ver mis Inscripciones
                        </a>
                        <a href="/alumno/inscripciones/nueva" class="btn btn-outline-primary btn-lg">
                            Inscribirme a un Curso
                        </a>
                    </div>
                </div>
            }
            else if (role?.ToLower() == "profesor")
            {
                <div class="mt-4">
                    <p>Eres un <strong>Profesor</strong>. Puedes:</p>
                    <div class="d-grid gap-2 col-6 mx-auto mt-3">
                        <a href="/profesor/cursos" class="btn btn-primary btn-lg">
                            Ver mis Cursos
                        </a>
                    </div>
                </div>
            }
            else if (role?.ToLower() == "admin")
            {
                <div class="mt-4">
                    <p><strong>Bienvenido Administrador!</strong></p>
                    <div class="d-grid gap-2 col-6 mx-auto mt-3">
                        <a href="/comisiones" class="btn btn-primary btn-lg">
                            Gestionar Comisiones
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="lead mt-4">
                Por favor, inicia sesión para continuar.
            </p>
            <div class="d-grid gap-2 col-6 mx-auto mt-4">
                <a href="/login" class="btn btn-primary btn-lg">
                    Iniciar Sesión
                </a>
            </div>
        }
    </div>
</div>
