@page "/comisiones/detalle"
@page "/comisiones/detalle/{IdComision:int}"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Shared
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(IdComision.HasValue ? "Modificar Comisión" : "Nueva Comisión")</PageTitle>

<AuthorizeView RequireAdmin="true">
    <div class="container mt-4">
        <div class="card">
            <div class="card-header">
                <h4>@(IdComision.HasValue ? "Modificar Comisión" : "Nueva Comisión")</h4>
            </div>
            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else if (errorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Error:</strong> @errorMessage
                    </div>
                }
                else
                {
                    <form @onsubmit="GuardarComision" @onsubmit:preventDefault="true">
                        <div class="mb-3">
                            <label for="descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" 
                                   id="descripcion" 
                                   class="form-control @(errorDescripcion ? "is-invalid" : "")" 
                                   @bind="comision.Desc_comision"
                                   @bind:event="oninput"
                                   placeholder="Ingrese la descripción de la comisión" />
                            @if (errorDescripcion)
                            {
                                <div class="invalid-feedback">La descripción es requerida</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="anioEspecialidad" class="form-label">Año Especialidad <span class="text-danger">*</span></label>
                            <input type="number" 
                                   id="anioEspecialidad" 
                                   class="form-control @(errorAnio ? "is-invalid" : "")" 
                                   @bind="comision.Anio_especialidad"
                                   @bind:event="oninput"
                                   min="1"
                                   placeholder="Ingrese el año de especialidad" />
                            @if (errorAnio)
                            {
                                <div class="invalid-feedback">El año debe ser mayor a 0</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="plan" class="form-label">Plan <span class="text-danger">*</span></label>
                            <select id="plan" 
                                    class="form-select @(errorPlan ? "is-invalid" : "")" 
                                    @bind="comision.Id_plan">
                                <option value="0">Seleccione un plan</option>
                                @if (planes != null)
                                {
                                    @foreach (var plan in planes)
                                    {
                                        <option value="@plan.IdPlan">@plan.Descripcion</option>
                                    }
                                }
                            </select>
                            @if (errorPlan)
                            {
                                <div class="invalid-feedback">Debe seleccionar un plan</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-success" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar</span>
                                }
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</AuthorizeView>

@if (mostrarConfirmacionReactivacion)
{
    <MensajeConfirmacionModal 
        Mensaje="@mensajeConfirmacion"
        OnConfirmar="ConfirmarReactivacion"
        OnCancelar="CancelarReactivacion" />
}

@code {
    [Parameter]
    public int? IdComision { get; set; }

    private ComisionDTO comision = new ComisionDTO { Habilitado = true };
    private List<PlanDTO>? planes;
    private string? errorMessage;
    private bool errorDescripcion = false;
    private bool errorAnio = false;
    private bool errorPlan = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool mostrarConfirmacionReactivacion = false;
    private string mensajeConfirmacion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            planes = await APIPlan.GetAllAsync();

            if (IdComision.HasValue)
            {
                var comisionExistente = await APIComision.GetAsync(IdComision.Value);
                
                if (comisionExistente != null)
                {
                    comision = comisionExistente;

                    if (!comision.Habilitado)
                    {
                        mensajeConfirmacion = "Esta comisión está deshabilitada.\n\nAl reactivarla se habilitarán todos los cursos relacionados.\n\n¿Desea darla de alta?";
                        mostrarConfirmacionReactivacion = true;
                    }
                }
                else
                {
                    errorMessage = "No se encontró la comisión";
                }
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmarReactivacion()
    {
        mostrarConfirmacionReactivacion = false;
        
        try
        {
            comision.Habilitado = true;
            await APIComision.UpdateAsync(comision);
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void CancelarReactivacion()
    {
        mostrarConfirmacionReactivacion = false;
        Navigation.NavigateTo("/comisiones");
    }

    private bool ValidarFormulario()
    {
        bool esValido = true;

        errorDescripcion = false;
        errorAnio = false;
        errorPlan = false;

        if (string.IsNullOrWhiteSpace(comision.Desc_comision))
        {
            errorDescripcion = true;
            esValido = false;
        }

        if (comision.Anio_especialidad <= 0)
        {
            errorAnio = true;
            esValido = false;
        }

        if (comision.Id_plan <= 0)
        {
            errorPlan = true;
            esValido = false;
        }

        return esValido;
    }

    private async Task GuardarComision()
    {
        if (!ValidarFormulario())
        {
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            if (IdComision.HasValue)
            {
                await APIComision.UpdateAsync(comision);
            }
            else
            {
                await APIComision.AddAsync(comision);
            }

            Navigation.NavigateTo("/comisiones");
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar la comisión: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/comisiones");
    }
}
