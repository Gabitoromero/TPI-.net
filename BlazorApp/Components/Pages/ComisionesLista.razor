@page "/comisiones"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Shared
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Comisiones</PageTitle>

<AuthorizeView RequireAdmin="true">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Comisiones</h3>
            <button class="btn btn-primary" @onclick="AgregarComision">
                <i class="bi bi-plus-circle"></i> Agregar
            </button>
        </div>

        @if (comisiones == null)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p>Cargando comisiones...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Error:</strong> @errorMessage
            </div>
        }
        else if (!comisiones.Any())
        {
            <div class="alert alert-info" role="alert">
                No hay comisiones registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Año Especialidad</th>
                            <th>Plan</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comision in comisiones)
                        {
                            <tr>
                                <td>@comision.Id_comision</td>
                                <td>@comision.Desc_comision</td>
                                <td>@comision.Anio_especialidad</td>
                                <td>@comision.PlanDescripcion</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => ModificarComision(comision.Id_comision)">
                                        <i class="bi bi-pencil"></i> Modificar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => MostrarConfirmacionEliminar(comision.Id_comision, comision.Desc_comision)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</AuthorizeView>

@if (mostrarConfirmacion)
{
    <MensajeConfirmacionModal 
        Mensaje="@mensajeConfirmacion"
        OnConfirmar="ConfirmarEliminar"
        OnCancelar="CancelarEliminar" />
}

@code {
    private List<ComisionDisplayDTO>? comisiones;
    private string? errorMessage;
    private bool mostrarConfirmacion = false;
    private string mensajeConfirmacion = string.Empty;
    private int idComisionAEliminar;
    private string descripcionComisionAEliminar = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarComisiones();
    }

    private async Task CargarComisiones()
    {
        try
        {
            errorMessage = null;
            var comisionesDto = await APIComision.GetAllAsync();
            var planes = await APIPlan.GetAllAsync();

            comisiones = comisionesDto.Select(c => new ComisionDisplayDTO
            {
                Id_comision = c.Id_comision,
                Desc_comision = c.Desc_comision,
                Anio_especialidad = c.Anio_especialidad,
                Id_plan = c.Id_plan,
                Habilitado = c.Habilitado,
                PlanDescripcion = planes.FirstOrDefault(p => p.IdPlan == c.Id_plan)?.Descripcion ?? "Sin plan"
            }).ToList();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las comisiones: {ex.Message}";
        }
    }

    private void AgregarComision()
    {
        Navigation.NavigateTo("/comisiones/detalle");
    }

    private void ModificarComision(int id)
    {
        Navigation.NavigateTo($"/comisiones/detalle/{id}");
    }

    private void MostrarConfirmacionEliminar(int id, string descripcion)
    {
        idComisionAEliminar = id;
        descripcionComisionAEliminar = descripcion;
        mensajeConfirmacion = $"¿Está seguro que desea eliminar la comisión '{descripcion}'?\n\nSe darán de baja todos los cursos de esta comisión. Esta acción no se puede deshacer.";
        mostrarConfirmacion = true;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirmacion = false;
        
        try
        {
            await APIComision.DeleteAsync(idComisionAEliminar);
            await CargarComisiones();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la comisión: {ex.Message}";
        }
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

}
