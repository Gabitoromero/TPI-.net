<div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <span class="bi bi-check-circle-fill me-2"></span>
                    Inscripción Confirmada
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-3">
                    <div class="display-1 text-success mb-3">
                        <span class="bi bi-check-circle"></span>
                    </div>
                    <p style="white-space: pre-line;">@Mensaje</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Cerrar">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Mensaje { get; set; }

    [Parameter]
    public EventCallback OnCerrar { get; set; }

    private void Cerrar()
    {
        OnCerrar.InvokeAsync();
    }
}
