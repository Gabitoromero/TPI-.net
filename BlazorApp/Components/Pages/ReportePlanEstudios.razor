@page "/reporte/plan-estudios"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Reports
@using QuestPDF.Fluent
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Reporte Plan de Estudios</PageTitle>

<div class="container mt-4">
    @if (generando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Generando reporte...</span>
            </div>
            <h4 class="mt-3">Generando tu reporte...</h4>
            <p class="text-muted">Esto puede tomar unos segundos</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <h5>Error al generar el reporte</h5>
            <p>@errorMessage</p>
            <button class="btn btn-primary mt-2" @onclick="Volver">
                Volver a Mis Inscripciones
            </button>
        </div>
    }
    else if (!string.IsNullOrEmpty(pdfBase64))
    {
        <div class="row">
            <div class="col-12 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4>@nombreArchivo</h4>
                    <div>
                        <button class="btn btn-secondary" @onclick="Volver">
                            Volver
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="col-12">
                <iframe 
                    src="@($"data:application/pdf;base64,{pdfBase64}")"
                    style="width: 100%; height: 80vh; border: 1px solid #ddd; border-radius: 4px;"
                    title="Reporte Plan de Estudios">
                </iframe>
            </div>
        </div>
    }
</div>

@code {
    private bool generando = true;
    private string? errorMessage;
    private string? pdfBase64;
    private string? nombreArchivo;

    protected override async Task OnInitializedAsync()
    {
        await GenerarReporte();
    }

    private async Task GenerarReporte()
    {
        try
        {
            generando = true;
            StateHasChanged();

            var alumnoId = JwtHelper.GetUserId(APIClientBase.LoginResponse?.Token);

            if (alumnoId == null)
            {
                errorMessage = "No se pudo obtener el ID del usuario. Por favor, inicie sesión nuevamente.";
                return;
            }

            var datosReporte = await ReportePlanAlumnoService.ObtenerDatosReporteAsync(alumnoId.Value);

            string nombreAlumno = datosReporte.NombreCompleto.Replace(" ", "_").Replace("/", "-");
            string fecha = DateTime.Now.ToString("yyyyMMdd");
            nombreArchivo = $"Plan_Estudios_{nombreAlumno}_{fecha}.pdf";

            var document = new PlanAlumnoReportDocument(datosReporte);
            byte[] pdfBytes = document.GeneratePdf();

            pdfBase64 = Convert.ToBase64String(pdfBytes);

            generando = false;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            generando = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar el reporte: {ex.Message}";
            generando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/alumno/inscripciones");
    }
}
