@page "/profesor/cursos/{IdCurso:int}/alumnos"
@using API.Clients
@using DTOs
@using Application.Services
@using BlazorApp.Components.Shared
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Alumnos del Curso</PageTitle>

<AuthorizeView RequireProfesor="true">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Alumnos del Curso</h3>
        <button class="btn btn-secondary" @onclick="Volver">Volver</button>
    </div>

    @if (profesorDeshabilitado)
    {
        <div class="alert alert-warning" role="alert">
            <strong>⚠ Cuenta Deshabilitada:</strong> Tu cuenta no está habilitada. Por favor, contacta al administrador.
        </div>
    } else
    {
        @if (alumnosDelCurso == null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }
        else if (!alumnosDelCurso.Any())
        {
            <div class="alert alert-info" role="alert">
                No hay alumnos inscriptos en este curso.
            </div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Legajo</th>
                        <th>Nombre de Usuario</th>
                        <th>Condición</th>
                        <th>Nota</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alumno in alumnosDelCurso)
                    {
                        <tr>
                            <td>@alumno.Alumno.Legajo</td>
                            <td>@alumno.Alumno.NombreUsuario</td>
                            <td>@alumno.Condicion</td>
                            <td>@(alumno.Nota?.ToString() ?? "-")</td>
                            <td>
                                <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEdicion(alumno)">
                                    Modificar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (mostrarModal)
        {
            <EditarAlumnoModal AlumnoSeleccionado="alumnoSeleccionado"
                               OnCerrar="CerrarModal"
                               OnGuardado="OnAlumnoActualizado" />
        }
    }
</AuthorizeView>

@code {
    [Parameter]
    public int IdCurso { get; set; }

    private List<ShowAlumno_CursoDTO> alumnosDelCurso;
    private string errorMessage;
    private bool mostrarModal = false;
    private bool profesorDeshabilitado = false;
    private ShowAlumno_CursoDTO alumnoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        var profesor = await APIUsuario.GetByUsernameAsync(APIClientBase.LoginResponse?.Username);

        if (profesor == null)
        {
            errorMessage = "Usuario no encontrado";
            return;
        }

        if (profesor.Habilitado == false)
        {
            profesorDeshabilitado = true;
            return;
        }
        await CargarAlumnos();
    }

    private async Task CargarAlumnos()
    {
        try
        {
            
            var todosLosAlumnos = await APIUsuario.GetAlumnosCompletoByCursoAsync(IdCurso);


            alumnosDelCurso = todosLosAlumnos.Where(a => a.Alumno.Habilitado == true).ToList();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los alumnos: {ex.Message}";
        }
    }

    private void AbrirModalEdicion(ShowAlumno_CursoDTO alumno)
    {
        alumnoSeleccionado = alumno;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        alumnoSeleccionado = null;
    }

    private async Task OnAlumnoActualizado()
    {
        CerrarModal();
        await CargarAlumnos();
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/profesor/cursos");
    }
}
