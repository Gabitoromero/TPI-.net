@page "/test-jwt"
@using API.Clients
@using DTOs
@using BlazorApp.Components.Shared
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Test JWT - Verificación de Token</PageTitle>

<AuthorizeView>
    <div class="container mt-5">
        <h2>?? Prueba de Seguridad JWT</h2>
        <p class="lead">Esta página está protegida y requiere autenticación</p>

        <hr class="my-4" />

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">? Información del Usuario Autenticado</h5>
                    </div>
                    <div class="card-body">
                        @{
                            var currentUser = APIClientBase.LoginResponse;
                            var userId = JwtHelper.GetUserId(currentUser?.Token);
                            var username = JwtHelper.GetUsername(currentUser?.Token);
                            var email = JwtHelper.GetEmail(currentUser?.Token);
                            var role = JwtHelper.GetRole(currentUser?.Token);
                        }
                        
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th>Usuario:</th>
                                    <td>@(username ?? currentUser?.Username)</td>
                                </tr>
                                <tr>
                                    <th>Email:</th>
                                    <td>@(email ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th>Tipo:</th>
                                    <td>
                                        <span class="badge bg-info">@(role ?? currentUser?.Tipo)</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>User ID:</th>
                                    <td>@(userId?.ToString() ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th>Es Profesor:</th>
                                    <td>@(JwtHelper.HasRole(currentUser?.Token, "Profesor") ? "? Sí" : "? No")</td>
                                </tr>
                                <tr>
                                    <th>Es Alumno:</th>
                                    <td>@(JwtHelper.HasRole(currentUser?.Token, "Alumno") ? "? Sí" : "? No")</td>
                                </tr>
                                <tr>
                                    <th>Token Válido Hasta:</th>
                                    <td>@currentUser?.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                            </tbody>
                        </table>

                        @if (currentUser?.Token != null)
                        {
                            <div class="mt-3">
                                <label class="form-label fw-bold">Token JWT (primeros 50 caracteres):</label>
                                <div class="alert alert-secondary small" style="word-break: break-all;">
                                    @currentUser.Token.Substring(0, Math.Min(50, currentUser.Token.Length))...
                                </div>
                                <button class="btn btn-sm btn-outline-primary" @onclick="CopyTokenToClipboard">
                                    ?? Copiar Token Completo
                                </button>
                                @if (tokenCopiado)
                                {
                                    <span class="text-success ms-2">? Token copiado!</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">?? Probar Endpoint con JWT</h5>
                    </div>
                    <div class="card-body">
                        <p>Haz clic en el botón para hacer una petición al endpoint de especialidades:</p>
                        
                        <button class="btn btn-success w-100 mb-3" @onclick="ProbarEndpoint" disabled="@cargando">
                            @if (cargando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Cargando...</span>
                            }
                            else
                            {
                                <span>?? Llamar al Endpoint /especialidades</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(mensajeResultado))
                        {
                            <div class="alert @(resultadoExitoso ? "alert-success" : "alert-danger")">
                                <strong>@(resultadoExitoso ? "? Éxito:" : "? Error:")</strong>
                                <p class="mb-0">@mensajeResultado</p>
                            </div>
                        }

                        @if (especialidades != null && especialidades.Any())
                        {
                            <div class="mt-3">
                                <h6>Especialidades obtenidas (@especialidades.Count):</h6>
                                <ul class="list-group">
                                    @foreach (var esp in especialidades.Take(5))
                                    {
                                        <li class="list-group-item">
                                            <strong>@esp.Id</strong> - @esp.Descripcion
                                        </li>
                                    }
                                    @if (especialidades.Count > 5)
                                    {
                                        <li class="list-group-item text-muted">
                                            ... y @(especialidades.Count - 5) más
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-info">
            <h6>?? Instrucciones:</h6>
            <ol class="mb-0">
                <li>Abre la <strong>Consola del Navegador</strong> (F12 ? Console) para ver los claims del token</li>
                <li>Abre la <strong>Consola de Visual Studio</strong> (WebAPI) para ver los logs del servidor</li>
                <li>Haz clic en <strong>"Llamar al Endpoint"</strong> para probar</li>
                <li>Verifica en ambas consolas que el token se envía y recibe correctamente</li>
            </ol>
        </div>

        <div class="mt-3">
            <a href="/" class="btn btn-secondary">? Volver al Inicio</a>
            @if (JwtHelper.HasRole(APIClientBase.LoginResponse?.Token, "Profesor"))
            {
                <a href="/profesor/cursos" class="btn btn-primary">Ver Mis Cursos</a>
            }
            @if (JwtHelper.HasRole(APIClientBase.LoginResponse?.Token, "Alumno"))
            {
                <a href="/alumno/inscripciones" class="btn btn-primary">Ver Mis Inscripciones</a>
            }
        </div>
    </div>
</AuthorizeView>

@code {
    private List<EspecialidadDTO>? especialidades;
    private bool cargando = false;
    private string? mensajeResultado;
    private bool resultadoExitoso = false;
    private bool tokenCopiado = false;

    protected override void OnInitialized()
    {
        // Log del token en la consola del navegador
        var currentUser = APIClientBase.LoginResponse;
        
        if (currentUser?.Token != null)
        {
            Console.WriteLine("\n=== ?? TEST JWT - INFORMACIÓN DEL TOKEN ===");
            Console.WriteLine($"Token: {currentUser.Token}");
            
            try
            {
                var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
                var jsonToken = handler.ReadJwtToken(currentUser.Token);
                
                Console.WriteLine("\n?? Claims en el token:");
                foreach (var claim in jsonToken.Claims)
                {
                    Console.WriteLine($"  {claim.Type} = {claim.Value}");
                }
                
                Console.WriteLine($"\n? Token expira: {jsonToken.ValidTo}");
                Console.WriteLine($"?? Algoritmo: {jsonToken.SignatureAlgorithm}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"? Error al decodificar token: {ex.Message}");
            }
            
            Console.WriteLine("==========================================\n");
        }
    }

    private async Task ProbarEndpoint()
    {
        cargando = true;
        mensajeResultado = null;
        especialidades = null;
        resultadoExitoso = false;
        tokenCopiado = false;

        try
        {
            Console.WriteLine("\n=== ?? INICIANDO PETICIÓN AL ENDPOINT ===");
            Console.WriteLine($"?? Enviando token: {APIClientBase.LoginResponse?.Token?.Substring(0, 20)}...");
            Console.WriteLine("Endpoint: GET /especialidades");
            
            especialidades = await APIEspecialidad.GetAllAsync();
            
            Console.WriteLine($"? Respuesta recibida: {especialidades?.Count ?? 0} especialidades");
            Console.WriteLine("==========================================\n");

            mensajeResultado = $"Se obtuvieron {especialidades?.Count ?? 0} especialidades correctamente. ¡El token JWT funcionó!";
            resultadoExitoso = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"? Error en la petición: {ex.Message}");
            Console.WriteLine("==========================================\n");
            
            mensajeResultado = $"Error al llamar al endpoint: {ex.Message}";
            resultadoExitoso = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CopyTokenToClipboard()
    {
        if (APIClientBase.LoginResponse?.Token != null)
        {
            // En Blazor Server, necesitamos usar JavaScript para copiar al portapapeles
            Console.WriteLine($"?? Token completo:\n{APIClientBase.LoginResponse.Token}");
            tokenCopiado = true;
            
            // El token se imprime en la consola para copiarlo manualmente
            await Task.Delay(2000);
            tokenCopiado = false;
        }
    }
}
