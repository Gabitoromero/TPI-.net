@page "/materias"
@using API.Clients
@using DTOs
@using BlazorApp.Services
@using BlazorApp.Components.Shared
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Materias</PageTitle>

<AuthorizeView RequireAdmin="true">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Materias</h3>
            <button class="btn btn-primary" @onclick="AgregarMateria">
                <i class="bi bi-plus-circle"></i> Agregar
            </button>
        </div>

        @if (materias == null)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p>Cargando materias...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Error:</strong> @errorMessage
            </div>
        }
        else if (!materias.Any())
        {
            <div class="alert alert-info" role="alert">
                No hay materias registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Descripción</th>
                            <th>Hs. Semanales</th>
                            <th>Hs. Totales</th>
                            <th>Plan</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var materia in materias)
                        {
                            <tr>
                                <td>@materia.Id_materia</td>
                                <td>@materia.Desc_materia</td>
                                <td>@materia.Hs_semanales</td>
                                <td>@materia.Hs_totales</td>
                                <td>@materia.PlanDescripcion</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => ModificarMateria(materia.Id_materia)">
                                        <i class="bi bi-pencil"></i> Modificar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => MostrarConfirmacionEliminar(materia.Id_materia, materia.Desc_materia)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</AuthorizeView>

@if (mostrarConfirmacion)
{
    <MensajeConfirmacionModal 
        Mensaje="@mensajeConfirmacion"
        OnConfirmar="ConfirmarEliminar"
        OnCancelar="CancelarEliminar" />
}

@code {
    private List<MateriaDisplayDTO>? materias;
    private List<MateriaDTO>? materiasDto;
    private List<PlanDTO>? planes;
    private string? errorMessage;
    private bool mostrarConfirmacion = false;
    private string mensajeConfirmacion = string.Empty;
    private int idMateriaAEliminar;
    private string descripcionMateriaAEliminar = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarMaterias();
    }

    private async Task CargarMaterias()
    {
        try
        {
            errorMessage = null;
            materiasDto = await APIMateria.GetAllAsync();
            planes = await APIPlan.GetAllAsync();

            materias = materiasDto.Select(m => new MateriaDisplayDTO
            {
                Id_materia = m.Id_materia,
                Desc_materia = m.Desc_materia,
                Hs_semanales = m.Hs_semanales,
                Hs_totales = m.Hs_totales,
                Id_plan = m.Id_plan,
                PlanDescripcion = planes.FirstOrDefault(p => p.IdPlan == m.Id_plan)?.Descripcion 
            }).ToList();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las materias: {ex.Message}";
        }
    }

    private void AgregarMateria()
    {
        Navigation.NavigateTo("/materias/detalle");
    }

    private void ModificarMateria(int id)
    {
        Navigation.NavigateTo($"/materias/detalle/{id}");
    }

    private void MostrarConfirmacionEliminar(int id, string descripcion)
    {
        idMateriaAEliminar = id;
        descripcionMateriaAEliminar = descripcion;
        mensajeConfirmacion = $"¿Está seguro que desea eliminar la materia '{descripcion}'?\n\nEsta acción no se puede deshacer.";
        mostrarConfirmacion = true;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirmacion = false;
        
        try
        {
            await APIMateria.DeleteAsync(idMateriaAEliminar);
            await CargarMaterias();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la materia: {ex.Message}";
        }
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }
}
