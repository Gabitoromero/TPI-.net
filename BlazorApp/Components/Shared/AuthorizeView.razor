@using API.Clients
@inject NavigationManager Navigation
@implements IDisposable

@if (isAuthorized)
{
    @ChildContent
}
else if (isChecking)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool RequireAlumno { get; set; } = false;

    [Parameter]
    public bool RequireProfesor { get; set; } = false;

    [Parameter]
    public bool RequireAdmin { get; set; } = false;

    private bool isAuthorized = false;
    private bool isChecking = true;

    protected override void OnInitialized()
    {
        CheckAuthorization();
    }

    private void CheckAuthorization()
    {
        isChecking = false;

        if (!APIClientBase.IsTokenValid())
        {
            var returnUrl = Uri.EscapeDataString(Navigation.Uri.Replace(Navigation.BaseUri, "/"));
            Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
            return;
        }

        var role = APIClientBase.LoginResponse?.Tipo;
        
        if (RequireAlumno && role?.ToLower() != "alumno")
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        if (RequireProfesor && role?.ToLower() != "profesor")
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        if (RequireAdmin && role?.ToLower() != "admin")
        {
            Navigation.NavigateTo("/", forceLoad: false);
            return;
        }

        isAuthorized = true;
        StateHasChanged();
    }

    public void Dispose()
    {
    }
}
